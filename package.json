{
  "name": "ownmypin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OwnMyPin backend — digital identity & smart-address platform (Phase 1: Core Backend)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "npx prisma generate",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "seed:categories": "node scripts/seed-business-categories.mjs",
    "admin:seed": "node scripts/seed-admin.mjs",
    "export:postman": "node scripts/export-postman.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "busboy": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "swagger-jsdoc": "^6.3.0",
    "zod": "^3.24.2",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.3.0",
    "eslint-config-prettier": "^10.1.1",
    "openapi-to-postmanv2": "^6.3.2",
    "prettier": "^3.5.3",
    "swagger-ui-dist": "^5.32.12",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
