# ------------------------------------------------------------------
# OwnMyPin Backend — environment variables (copy to .env and fill in)
# ------------------------------------------------------------------

# MySQL connection string (Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/ownmypin"

# JWT secrets — use long random strings (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# OTP provider: console | yourbulksms | (future: msg91, twilio, aws-sns, ...)
OTP_PROVIDER="console"
OTP_PROVIDER_API_KEY=""

# YourBulkSMS (control.yourbulksms.com) — required when OTP_PROVIDER="yourbulksms"
YOURBULKSMS_AUTHKEY=""
# DLT-registered 6-char sender id (e.g. OMPINM) + approved template id from the provider
YOURBULKSMS_SENDER_ID=""
YOURBULKSMS_DLT_TE_ID=""
YOURBULKSMS_ROUTE="2"
YOURBULKSMS_COUNTRY="0"
# The approved DLT template text with {code} where the OTP digits go
YOURBULKSMS_OTP_TEMPLATE="Your OwnMyPin OTP is {code}. Valid for 5 minutes. Do not share it."

# Dev OTP bypass — when enabled, OTP_BYPASS_MOBILE receives no SMS and
# OTP_BYPASS_CODE always verifies. Disable (false) in production.
OTP_BYPASS_ENABLED="false"
OTP_BYPASS_MOBILE=""
OTP_BYPASS_CODE="123456"

# Salt used to hash OTPs before storage (never store plain OTP)
OTP_HASH_SALT="change-me-otp-salt"

# Google Maps API key (only if LOCATION_PROVIDER=google in the future)
GOOGLE_MAPS_API_KEY=""

# Storage provider: local | (future: s3, gcs, ...)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Local dev storage directory (used when STORAGE_PROVIDER=local)
STORAGE_LOCAL_DIR="./public/uploads"

# Location provider: osm (OpenStreetMap Nominatim — free, keyless) | mock | (future: google)
LOCATION_PROVIDER="osm"

# Rate limiter backend: memory | (future: redis)
RATE_LIMIT_BACKEND="memory"

# Comma-separated CORS origin allowlist (Flutter app + Admin Panel domains).
# Requests with a browser Origin not listed here are rejected with 403.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Server
PORT=3000
NODE_ENV="development"
